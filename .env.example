# ──────────────────────────────────────────────────────────────────────────────
# Meridian Terminal — market data configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the providers you have access to.
# No keys are required: without credentials the app runs on its built-in,
# deterministic simulation engine and labels every value as DEMO.
#
# Keys are read only on the server (route handlers) and are never sent to the
# browser. Use `.env.local`; do not commit real credentials.

# Force simulated data even when provider keys are present.
# Accepted values: "demo". Comment out (or leave empty) to allow live providers.
# MARKET_DATA_MODE=demo

# Twelve Data — multi-asset quotes + time series (equities, FX, indices, crypto)
# https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Finnhub — US equity quotes and crypto candles
# https://finnhub.io/pricing
FINNHUB_API_KEY=

# CoinGecko — aggregated crypto prices and OHLC history
# https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
